{
  "compilerOptions": {
    "target": "esnext",
    "sourceMap": true,
    "module": "esnext",
    "moduleResolution": "Bundler",
    "lib": [
      "esnext",
      "DOM",
      "DOM.Iterable"
    ],
    //    "declaration": false,
    //    "emitDeclarationOnly": true,
    //    "outDir": "./types",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "allowSyntheticDefaultImports": true,
    "experimentalDecorators": true,
    "forceConsistentCasingInFileNames": true,
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "types": [
      "vite-plus/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@arch-kiosk/appfoundation": ["../appfoundation/src/index.ts"],
      "#src/*": ["./src/*"]
    }
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "old"
  ],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}

