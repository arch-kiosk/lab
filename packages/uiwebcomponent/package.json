{
    "name": "@arch-kiosk/uicomponent",
    "version": "2.0.0",
    "private": true,
    "files": [
        "./dist"
    ],
    "type": "module",
    "main": "./dist/uicomponent.js",
    "module": "./dist/uicomponent.js",
    "types": "./dist/uicomponent.d.ts",
    "imports": {
        "#src/*": "./src/*"
    },
    "exports": {
        ".": {
            "types": "./dist/uicomponent.d.ts",
            "import": "./dist/uicomponent.js"
        }
    },
    "scripts": {
        "check types": "tsc",
        "fmt": "vp fmt -- -c ..\\..\\.oxfmtrc.json",
        "dev": "vp dev -- --force --host 127.0.0.1",
        "build-only": "tsc && vp build",
        "generate:schema": "ts-json-schema-generator --path .\\src\\uischema2.ts -t UISchema -o ./src/jsonschema/uischemav2.json --no-type-check",
        "generate:i18N": "npx i18next-cli extract",
        "docs:generate": "typedoc",
        "docs:dev": "pnpm docs:generate && vitepress dev docs",
        "docs:build": "vitepress build docs",
        "prepublishOnly": "vp run build",
        "bump-ver": "bumpp --no-push --commit \"bumped version to v%s\""
    },
    "dependencies": {
        "@arch-kiosk/appfoundation": "workspace:*",
        "@arch-kiosk/virtualizerlab": "workspace:*",
        "@vaadin/select": "^25.3.4",
        "@vaadin/combo-box": "^25.3.4",
        "@vaadin/date-picker": "^25.3.4",
        "@vaadin/date-time-picker": "^25.3.4",
        "ajv": "catalog:",
        "better-ajv-errors": "catalog:",
        "delay": "catalog:",
        "lit": "^3.3.3",
        "luxon": "^3.7.2"
    },
    "peerDependencies": {
        "i18next": "catalog:"
    },
    "devDependencies": {
        "@babel/core": "^7.29.7",
        "@babel/preset-env": "^7.29.7",
        "@types/jest": "^30.0.0",
        "@types/luxon": "^3.7.2",
        "@voidzero-dev/vite-plus-core": "catalog:",
        "babel-jest": "^30.4.1",
        "i18next-cli": "catalog:",
        "jest": "^29.7.0",
        "sass": "^1.58.0",
        "ts-jest": "^29.4.11",
        "ts-json-schema-generator": "catalog:",
        "ts-node": "^10.9.2",
        "typedoc": "catalog:",
        "typedoc-plugin-frontmatter": "catalog:",
        "typedoc-plugin-markdown": "catalog:",
        "typedoc-vitepress-theme": "catalog:",
        "vite": "catalog:",
        "vite-plus": "catalog:",
        "vitepress-sidebar": "catalog:"
    }
}
