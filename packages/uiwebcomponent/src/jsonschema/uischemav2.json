    "UISchema": {
      "additionalProperties": false,
      "description": "UISchema defines the top level structure of the schema definition. This is the starting point. The structure itself contains mostly contextual information for the use cases in which a schema appears.",
      "properties": {
        "data_binding": {
          "$ref": "#/definitions/UISchemaDataBindingSettings",
          "description": "describes the data source and how the ui is interacting with it"
        },
        "dsd": {
          "$ref": "#/definitions/UISchemaDSDDict",
          "description": "data set definition for database-bound elements within the definition. This is not being directly used by the ui component but it serves as contextual data that might be used by the host of the layout"
        },
        "header": {
          "$ref": "#/definitions/UISchemaHeaderDictV2",
          "description": "defines information about version and type of the definition language being used. These definitions control how to even parse the structure and what components and parts to expect."
        },
        "meta": {
          "$ref": "#/definitions/UISchemaMetaSettings",
          "description": "additional information used by diverse parties processing the schema. Not rendered within the ui but informing the context within which the schema is being interpreted or even rendered."
        },
        "root": {
          "$ref": "#/definitions/UISchemaUIRootLayoutElement",
          "description": "the root element has to be a layout element"
        }
      },
      "required": [
        "header",
        "data_binding",
        "root"
      ],
      "type": "object"
    },
