    "UISchemaUIElements": {
      "allOf": [
        {
          "if": {
            "properties": {
              "element_type": {
                "const": "layout",
                "type": "string"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/UISchemaLayoutElement"
          }
        },
        {
          "if": {
            "properties": {
              "element_type": {
                "const": "button",
                "type": "string"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/UISchemaButton"
          }
        },
        {
          "if": {
            "properties": {
              "element_type": {
                "const": "text_field",
                "type": "string"
              }
            }
          },
          "then": {
            "$ref": "#/definitions/UISchemaTextField"
