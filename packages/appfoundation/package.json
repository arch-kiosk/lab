{
  "name": "@arch-kiosk/appfoundation",
  "version": "0.0.4",
  "description": "fundamental building blocks for K67",
  "keywords": [
    "architecture",
    "foundation",
    "plugin manager",
    "typescript"
  ],
  "homepage": "https://github.com/arch-kiosk/lab/appfoundation",
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    },
    "./dataprovider": {
      "types": "./dist/dataprovider/index.d.mts",
      "import": "./dist/dataprovider/index.mjs",
      "default": "./dist/dataprovider/index.mjs"
    },
    "./package.json": "./package.json"  },
  "types": "./dist/index.d.mts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp test && vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check": "vp check",
    "rollout": "tsc && pnpm bump-ver && pnpm build",
    "docs:generate": "typedoc",
    "docs:dev": "pnpm docs:generate && vitepress dev docs",
    "docs:build": "vitepress build docs",
    "prepublishOnly": "vp run build",
    "bump-ver": "bumpp --no-push --commit \"bumped version to v%s\""
  },
  "dependencies": {
    "dexie": "catalog:",
    "pino": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "bumpp": "catalog:",
    "typedoc-plugin-markdown": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "catalog:",
    "vitepress-sidebar": "catalog:",
    "vitest": "catalog:"
  }
}
