{
  "name": "lab",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp run -r test && vp run -r build",
    "dev": "vp run website#dev",
    "prepare": "vp config",
    "pull:uiwebcomponent": "git subtree pull --prefix=packages/uiwebcomponent upstream-uiwebcomponent main --squash",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "oxc-minify": "catalog:",
    "sass": "catalog:",
    "typedoc-vitepress-theme": "catalog:",
    "vite-plus": "catalog:",
    "vitepress": "2.0.0-alpha.17",
    "vitepress-sidebar": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.9.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
