{
  "name": "@arch-kiosk/virtualizerlab",
  "description": "components coming out of the virtualizer lab",
  "keywords": [
    "architecture",
    "virtual scrolling",
    "lit",
    "web-component",
    "typescript"
  ],
  "version": "1.0.0-local",
  "homepage": "https://github.com/arch-kiosk",
  "bugs": {
    "url": "https://github.com/arch-kiosk"
  },
  "license": "MIT",
  "files": [
    "./dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "module": "./dist/virtualizerlab.js",
  "types": "./dist/virtualizerlab.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "imports": {
    "#src/*": "./src/*"
  },
  "scripts": {
    "check types": "tsc",
    "dev": "vp dev -- --force --host 127.0.0.1",
    "build": "vp build && tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "@arch-kiosk/appfoundation": "workspace:*",
    "@lit-labs/virtualizer": "catalog:",
    "@tanstack/lit-virtual": "catalog:",
    "@tanstack/virtual-core": "catalog:",
    "delay": "catalog:",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "sass": "^1.101.7",
    "ts-node": "^10.9.2",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  }
}
